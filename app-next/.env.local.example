# Copiar a .env.local (nunca commitear .env.local real) para desarrollo local,
# y cargar los mismos valores como Environment Variables del proyecto en Vercel.

# Passcode compartido para entrar a /lab. Elegido por Daniel, no generado ni
# commiteado por el agente.
LAB_PASSCODE=

# Secreto usado para firmar la cookie de sesión de /lab (HMAC-SHA256).
# Generar uno random largo, ej: openssl rand -base64 32
LAB_SESSION_SECRET=
